{
  "name": "synthetic-operations-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic demonstration of business software that is built, operated, observed and evolved: purchase approvals around an ERP.",
  "license": "MIT",
  "author": "Blaxline Group, LLC (https://blaxline.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blaxline/synthetic-operations-demo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "demo": "node src/demo/scenario.ts",
    "demo:impact": "node src/demo/impact.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "biome ci . && tsc && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
